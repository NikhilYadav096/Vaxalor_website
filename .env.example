# Contact form email delivery (https://resend.com)
RESEND_API_KEY=
# Where enquiries are delivered. Defaults to official@vaxalor.com
CONTACT_TO_EMAIL=official@vaxalor.com
# Sender address. Must be on a domain verified in Resend. Defaults to Resend's test sender.
CONTACT_FROM_EMAIL="Vaxalor Website <hello@vaxalor.com>"
